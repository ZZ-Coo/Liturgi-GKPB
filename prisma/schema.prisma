// ─────────────────────────────────────────────────────────────────────────
// Liturgi GKPB — Prisma Schema (v3: fresh DB, liturgi file viewer + warta builder)
//
// Pembagian tugas:
//   • Prisma  → tabel, kolom, enum, foreign key   (file ini)
//   • db/setup.sql → semua yang Prisma tidak bisa/tidak seharusnya urus:
//       trigger updatedAt, partial unique index, admin_users, GRANT, RLS,
//       fungsi baca publik, bucket + storage policy
//
// Kolom tetap camelCase supaya store/view yang sudah ada tidak perlu diubah.
// Default `gen_random_uuid()` dan `now()` ada di level DB (bukan client-side
// Prisma), jadi insert langsung dari supabase-js juga dapat id + timestamp.
// `updatedAt` diisi trigger `set_updated_at` (lihat setup.sql), bukan @updatedAt.
// ─────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Jemaat {
  id         String   @id @default(dbgenerated("gen_random_uuid()"))
  slug       String   @unique // "hosana-kwanji" -> /j/hosana-kwanji
  name       String
  category   String?
  // Optional extra layer on top of the slug: when set, the public link
  // becomes /j/<slug>-<accessCode> and the bare slug stops resolving (see
  // get_public_jemaat in db/setup.sql). Null by default — a slug on its
  // own is enough for now; this is here for when it stops being enough
  // (see README "Model keamanan"). Set/cleared via the SQL snippet in
  // db/setup.sql section 7, not through the app.
  accessCode String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())

  liturgi Liturgi[]
  warta   Warta[]

  @@map("jemaat")
}

model Pendeta {
  id     String   @id @default(dbgenerated("gen_random_uuid()"))
  code   String   @unique
  name   String
  titles String[] @default([])

  liturgi Liturgi[]

  @@map("pendeta")
}

enum Sesi {
  PAGI
  SIANG
  SORE
}

// Dipakai bersama oleh liturgi dan warta.
enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum FileType {
  PDF
  DOCX
}

model Liturgi {
  id       String   @id @default(dbgenerated("gen_random_uuid()"))
  jemaatId String
  jemaat   Jemaat   @relation(fields: [jemaatId], references: [id], onDelete: Cascade)
  tanggal  DateTime @db.Date // tanggal kalender polos — tanpa jam & timezone
  sesi     Sesi

  jamMulai     String? // hanya tampilan, mis. "07:30" — jadwal bisa geser tiap minggu
  mingguKe     String?
  tema         String?
  warnaLiturgi String?

  pendetaId   String?
  pendeta     Pendeta? @relation(fields: [pendetaId], references: [id])
  // Teks bebas = sumber kebenaran untuk tampilan. pendetaId cuma soft link
  // opsional (terisi kalau nama kebetulan cocok dengan data Pendeta).
  pendetaNama String?

  status PublishStatus @default(DRAFT)

  fileUrl          String // URL publik di bucket liturgi-files
  fileType         FileType
  originalFilename String

  // Soft delete: deletedAt terisi = "di sampah". Unique jemaat+tanggal+sesi
  // hanya berlaku untuk baris yang belum dihapus → partial unique index di
  // db/setup.sql (Prisma tidak bisa mengekspresikan WHERE pada index).
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([jemaatId, tanggal])
  @@map("liturgi")
}

// Warta jemaat: satu dokumen per jemaat + tanggal (mencakup Pagi & Sore).
// `sections` = array section berurutan, tiap section berisi array block:
//   [{ id, title, numbering, blocks: [{ id, type, title?, data }] }]
// Bentuk persisnya divalidasi di aplikasi (src/lib/warta/types.ts), bukan di DB.
model Warta {
  id        String        @id @default(dbgenerated("gen_random_uuid()"))
  jemaatId  String
  jemaat    Jemaat        @relation(fields: [jemaatId], references: [id], onDelete: Cascade)
  tanggal   DateTime      @db.Date
  sections  Json          @default("[]")
  status    PublishStatus @default(DRAFT)
  deletedAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @default(now())

  // Unique (jemaatId, tanggal) WHERE deletedAt IS NULL → di db/setup.sql
  @@index([jemaatId, tanggal])
  @@map("warta")
}
